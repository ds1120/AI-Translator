# Copy to .env for Docker Compose. Never commit the resulting file.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_USER_ID=
LINE_PUSH_ENABLED=false
# Use SPRING_PROFILES_ACTIVE=qwen, AI_PROVIDER=local-qwen, AI_MODEL=Qwen3-14B
# and your Qwen /v1 base URL for local inference (no API key required if endpoint has no auth).
SPRING_PROFILES_ACTIVE=live
AI_PROVIDER=external
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=15
DB_PASSWORD=replace-with-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password
