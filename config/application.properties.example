# Copy to config/application.properties and fill in your LINE credentials.
# Run java -jar from the project root. Spring Boot loads this file automatically.
spring.profiles.active=qwen
server.address=127.0.0.1
server.port=8090
spring.datasource.url=jdbc:h2:file:./backend/data/translator;MODE=MariaDB;DB_CLOSE_ON_EXIT=FALSE
spring.datasource.username=sa
spring.datasource.password=
app.mode=live
app.ai.provider=local-qwen
app.ai.base-url=http://127.0.0.1:8082/v1
app.ai.model=Qwen3-14B
app.ai.key=
# Default for conversations without a saved selection: TH, VI, EN, JA.
app.translation.partner-language=TH
app.line.push-enabled=false
app.line.secret=
app.line.token=
# Phase 2: checking runs even when /verification display is hidden.
app.verification.enabled=true
app.verification.budget-ms=30000
app.context.max-messages=10
app.context.ttl-seconds=600
# Optional independent verifier. Omit these to reuse the translation server/model.
# app.verification.provider=local-qwen
# app.verification.base-url=http://127.0.0.1:8083/v1
# app.verification.model=your-verification-model
# app.verification.key=
# Administrator login. Empty password disables login. Use at least 12 characters.
app.admin.username=admin
app.admin.password=
