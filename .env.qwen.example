# Copy to .env.qwen; keep the resulting file private.
SPRING_PROFILES_ACTIVE=qwen
AI_PROVIDER=local-qwen
AI_BASE_URL=https://dsss.mooo.com/v1
AI_MODEL=Qwen3-14B
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_USER_ID=
LINE_PUSH_ENABLED=false
DB_PASSWORD=replace-with-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password

# Admin UI: use a password with at least 12 characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional dedicated external-provider API keys
GEMINI_API_KEY=
OPENAI_API_KEY=
